    <!-- Health Connect -->
    <string name="hc_rationale_title">MyHealth and Health Connect</string>
    <string name="hc_rationale_what_we_read">MyHealth reads your workouts, steps, distance, speed, cadence, heart rate, resting heart rate, heart-rate variability, calories, floors, elevation, blood oxygen, respiratory rate, VO2 max, sleep, weight and body fat from Health Connect. It never writes anything back.</string>
    <string name="hc_rationale_why">This data is used to show your training history, to estimate training load and recovery, and to work out daily calorie and macro targets that match what you actually did.</string>
    <string name="hc_rationale_on_device">Your data stays on this device. MyHealth stores everything in a local database, has no account, and does not upload your health data to any server.</string>
    <string name="hc_rationale_revoke">You can withdraw access at any time in the Health Connect app. MyHealth then keeps only the data already synced, which you can delete from the app.</string>
